{
  "name": "gleamworks-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Niche service booking & quote builder — SolidJS + Hono + SQLite",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/tests/pricing.test.ts server/tests/availability.test.ts",
    "race-test": "tsx server/scripts/race-test.ts",
    "db:reset": "tsx server/scripts/reset-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@solidjs/router": "^0.15.4",
    "hono": "^4.13.19",
    "luxon": "^3.7.2",
    "solid-js": "^1.9.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.16"
  },
  "engines": {
    "node": ">=20.12"
  }
}
